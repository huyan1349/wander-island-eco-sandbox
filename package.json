{
  "name": "wander-island",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "vite --port=3002 --host=0.0.0.0",
    "server": "tsx server/index.ts",
    "server:old": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite node_modules/.vite-temp",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-home.mjs",
    "verify": "npm run lint && npm run test && npm run build",
    "security:audit": "npm audit --audit-level=high",
    "seed": "tsx server/seed.ts"
  },
